{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "..",
    // No emitimos .d.ts: el FE consume el tipo `AppRouter` desde el código
    // fuente (alias `backend/*`), no desde dist/. Además, tRPC v11 usa tipos
    // internos (p.ej. TrackedData de `tracked()` en subscriptions) que no se
    // pueden nombrar en un .d.ts portable (TS2883). El runtime solo necesita JS.
    "declaration": false,
    "declarationMap": false,
    "sourceMap": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["dist", "src/test"]
}

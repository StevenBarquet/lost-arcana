{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/conventions-reminder.mjs",
            "timeout": 10,
            "statusMessage": "Recordando convenciones de claude.md"
          }
        ]
      }
    ]
  }
}
